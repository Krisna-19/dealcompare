# DealCompare API - example environment configuration.
# Copy to .env and adjust as needed. Every variable is optional;
# unset variables fall back to the defaults shown below.

# --- Amazon scraping -------------------------------------------------
AMAZON_BASE_URL=https://www.amazon.in
MYNTRA_BASE_URL=https://www.myntra.com
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
HEADLESS_BROWSER=false            # true for server deployments
PAGE_LOAD_TIMEOUT_MS=60000
SELECTOR_TIMEOUT_MS=20000
MAX_RESULTS_PER_PLATFORM=8
MATCH_SCORE_THRESHOLD=10          # titles scoring below this are rejected

# --- HTTP client -------------------------------------------------------
HTTP_USER_AGENT=                  # falls back to USER_AGENT when empty
HTTP_ACCEPT_LANGUAGE=en-IN,en;q=0.9
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.0
HTTP_TIMEOUT_SECONDS=8.0
HTTP_PROXIES=                     # comma-separated proxy URLs; empty = direct

# --- Grouping / ranking --------------------------------------------------
GROUP_SIMILARITY_THRESHOLD=0.6

# --- Search cache ---------------------------------------------------------
# TTL (seconds) for cached search responses; same normalized query served from
# cache within this window. Set SEARCH_CACHE_ENABLED=false to disable caching.
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=300.0

# --- Affiliates ------------------------------------------------------------
AFFILIATE_BASE_URL=https://www.amazon.in
AMAZON_AFFILIATE_TAG=dealcompare19-21

# --- CORS ---------------------------------------------------------------------
# Comma-separated allow-list of origins permitted to call the API from
# browsers. Default covers local Vite dev servers and the production site:
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dealcompare.in
# Avoid "*": with credentials disabled it exposes the API to every site.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dealcompare.in
